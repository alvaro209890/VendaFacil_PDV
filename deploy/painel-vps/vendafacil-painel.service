[Unit]
Description=VendaFacil Painel SaaS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vendafacil
Group=vendafacil
WorkingDirectory=/opt/vendafacil/painel
EnvironmentFile=/etc/vendafacil/painel.env
ExecStart=/opt/vendafacil/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8080 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vendafacil/dados
MemoryMax=512M
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
