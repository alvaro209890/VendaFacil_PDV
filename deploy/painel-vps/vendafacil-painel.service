[Unit]
Description=VendaFacil - Painel SaaS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vendafacil
WorkingDirectory=/opt/vendafacil/painel
Environment=PAINEL_HOST=127.0.0.1
Environment=PAINEL_PORT=8080
Environment=PAINEL_DATA_DIR=/opt/vendafacil/dados
# Defina um segredo fixo e forte (gere com: openssl rand -hex 32)
Environment=PAINEL_JWT_SECRET=TROQUE_POR_UM_SEGREDO_FIXO
ExecStart=/opt/vendafacil/painel/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
